# Jangan biarkan browser/CDN menyimpan halaman HTML & PHP - salinan lama halaman
# login yang tersimpan di cache sempat membuat login di beberapa laptop berujung 404.
<IfModule mod_headers.c>
    <FilesMatch "\.(html?|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
